# Copy this file to .env and fill in your values. .env is git-ignored - never commit real keys.

# Required for the AutoGen agents. Leave empty to run the transparent offline demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: any OpenAI-compatible endpoint (Azure OpenAI proxy, Groq, Ollama, LM Studio...)
# Groq example:   OPENAI_BASE_URL=https://api.groq.com/openai/v1   OPENAI_MODEL=llama-3.3-70b-versatile
# Ollama example: OPENAI_BASE_URL=http://localhost:11434/v1        OPENAI_MODEL=llama3.1
OPENAI_BASE_URL=

# Escalate when the Resolution Agent's confidence is below this value (0-1)
CONFIDENCE_THRESHOLD=0.70
KB_TOP_K=4
AGENT_TIMEOUT_SECONDS=60
